---
export interface Props {
  title: string;
  date: string;
  location: string;
  description?: string;
  link?: string;
  image?: string;
}

const { title, date, location, description, link, image } = Astro.props;
---

<article class="event-card">
  {image && (
    <div class="event-card__image-wrap">
      <img src={image} alt={title} class="event-card__image" loading="lazy" />
    </div>
  )}
  <div class="event-card__body">
    <span class="event-card__date">{date}</span>
    <h3 class="event-card__title">{title}</h3>
    <p class="event-card__location">{location}</p>
    {description && <p class="event-card__desc">{description}</p>}
    {link && (
      <a href={link} class="btn btn--small" target="_blank" rel="noopener">
        Details
      </a>
    )}
  </div>
</article>

<style>
  .event-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 200px 1fr;
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .event-card:hover {
    border-color: var(--color-border-lit);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  .event-card__image-wrap {
    overflow: hidden;
  }

  .event-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-card__body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .event-card__date {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .event-card__title {
    font-size: 1.25rem;
  }

  .event-card__location {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .event-card__desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .event-card .btn {
    align-self: flex-start;
    margin-top: var(--space-sm);
  }

  @media (max-width: 600px) {
    .event-card {
      grid-template-columns: 1fr;
    }

    .event-card__image {
      height: 180px;
    }
  }
</style>
