---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="About — Dark Bloom Studio">
  <Header slot="header" />

  <section class="page-hero">
    <div class="container">
      <h1 class="page-title">About</h1>
    </div>
  </section>

  <section class="section">
    <div class="container about-layout">
      <div class="about-image">
        <img src={`${import.meta.env.BASE_URL}images/artist-placeholder.jpg`} alt="Portrait of the artist" />
      </div>
      <div class="about-text">
        <h2>The Artist Behind Dark Bloom</h2>
        <p>
          <!-- Replace with your friend's actual bio -->
          Dark Bloom Studio is the creative home of an artist drawn to the
          shadowed, the mythic, and the beautifully macabre. Working across
          traditional and digital media, each piece explores the space between
          darkness and wonder.
        </p>
        <p>
          Inspired by gothic literature, folklore, botanical illustration, and
          the natural cycle of decay and renewal, the work invites viewers to
          find beauty in what others might overlook — the moth at the candle,
          the flowers growing from bone, the light that only exists because
          of the dark.
        </p>
        <p>
          Prints are available year-round through this site. Originals and
          commissions are released periodically. Follow along on Instagram
          for works in progress, new releases, and event announcements.
        </p>

        <div class="about-links">
          <a href="https://instagram.com/" target="_blank" rel="noopener" class="btn btn--small">
            Instagram
          </a>
          <a href="mailto:hello@darkbloomstudio.com" class="btn btn--small">
            Email
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-xl);
    text-align: center;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    margin-bottom: var(--space-md);
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .about-image img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  .about-text h2 {
    margin-bottom: var(--space-lg);
  }

  .about-text p {
    font-size: 1.05rem;
    line-height: 1.9;
    margin-bottom: var(--space-md);
  }

  .about-links {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  @media (max-width: 768px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .about-image {
      max-width: 400px;
      margin: 0 auto;
    }
  }
</style>
