---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EventCard from '../../components/EventCard.astro';

const allEvents = (await getCollection('events', ({ data }) => data.published))
  .sort((a, b) => new Date(b.data.sortDate).getTime() - new Date(a.data.sortDate).getTime());

const today = new Date().toISOString().slice(0, 10);
const upcomingEvents = allEvents.filter(e => e.data.sortDate >= today);
const pastEvents = allEvents.filter(e => e.data.sortDate < today);
---

<BaseLayout title="Events — Dark Bloom Studio">
  <Header slot="header" />

  <section class="page-hero">
    <div class="container">
      <h1 class="page-title">Events</h1>
      <p class="page-desc">
        Markets, conventions, and gallery shows where you can see the art in person
        and pick up prints, originals, and exclusive pieces.
      </p>
    </div>
  </section>

  <!-- Upcoming Events -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Upcoming</h2>
      <div class="events-list stagger">
        {upcomingEvents.map(event => (
          <EventCard
            title={event.data.title}
            date={event.data.date}
            location={event.data.location}
            description={event.data.description}
            link={event.data.link}
            image={event.data.image}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Past Events -->
  <section class="section past-events">
    <div class="container">
      <h2 class="section-title">Past Events</h2>
      <div class="events-list stagger">
        {pastEvents.map(event => (
          <EventCard
            title={event.data.title}
            date={event.data.date}
            location={event.data.location}
            description={event.data.description}
            link={event.data.link}
            image={event.data.image}
          />
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-xl);
    text-align: center;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    margin-bottom: var(--space-md);
  }

  .page-desc {
    max-width: 560px;
    margin: 0 auto;
    font-size: 1.05rem;
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .past-events {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
  }
</style>
